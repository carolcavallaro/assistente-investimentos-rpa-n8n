      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const csvText = $input.item.json.data || $input.item.json.body || Object.values($input.item.json)[0];\nconst lines = csvText.trim().split('\\n');\nconst headers = lines[0].split(',').map(h => h.trim());\n\nconst investments = [];\nfor (let i = 1; i < lines.length; i++) {\n  const currentLine = lines[i].split(',').map(item => item.trim());\n  if (currentLine.length === headers.length) {\n    const obj = {};\n    for (let j = 0; j < headers.length; j++) {\n      obj[headers[j]] = currentLine[j];\n    }\n    investments.push(obj);\n  }\n}\n\nreturn investments.map(inv => ({ json: inv }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "917ef0d4-c625-448e-8e14-6bcfd9aa6b92",
      "name": "Code in JavaScript"
