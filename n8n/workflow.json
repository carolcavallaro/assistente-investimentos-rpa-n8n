        -144
      ],
      "id": "80d4dd75-1815-499c-b079-7293868afce5",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const nome = data.nome || \"Cliente\";\n  const perfil = data.perfil || \"Conservador\";\n  const saldo = data.saldo || \"R$ 0,00\";\n  const produto = data.Produto || \"Renda Fixa\";\n  const rentabilidade = data.Rentabilidade || \"100% CDI\";\n\n  let mensagem = `Olá ${nome}, seu perfil é ${perfil} e seu saldo atual é ${saldo}. Recomendamos investir em ${produto} com rentabilidade de ${rentabilidade}.`;\n\n  results.push({ json: { nome, perfil, mensagem } });\n}\n\nreturn results;"
      },
